# ============================================================
#  InfiniGo（玄清围弈）· 不进入仓库的东西
# ============================================================

# ---------- 依赖：别人自己 npm install ----------
node_modules/

# ---------- 本机运行时产物 ----------
# settings.json 里存的是**你本机的引擎绝对路径**（设置面板保存时生成）。
# 发出去等于把自己的盘符结构公开，而且别人拿到也没用（路径不一样）。
settings.json

# 引擎日志（每次跑 KataGo 都会写）
engine-logs/

# 棋谱库（你的真实对局，涉及隐私）
records/

# 习题题集（2026-10-14 加：导入的 SGF 题集，一份可能几百道题）
# ★ 开发期拿真实题集当测试夹具时，夹具放 dev/fixtures/ —— **别放 puzzles/**（那是用户数据）
puzzles/

# 开发期的临时产物：测试截图 / 中间日志 / 探针脚本
_trash/

# ★ 2026-10-15 补：dev/_precheck.mjs 在"模板串求值失败"时会把它抠出来的片段写成
#   dev/_precheck_fail_*.js（方便你直接 node --check 看错在哪）。**那是临时产物，别提交**
#   —— 我这次就在 git status 里看到它了（幸好没 add -A）。
dev/_precheck_fail_*.js

# 测试脚本吐在根目录的截图（_cdp_xxx.mjs 的副产物）。
# ⚠️ 只忽略截图，**不忽略 `_*.mjs`** —— 那批测试脚本是刻意进仓库的
# （见 现状与待办.md「怎么验证改动没坏东西」），将来别人接手能直接跑。
/_.*.png

# 提交信息临时文件（用 git commit -F 传多行说明用，用完即删；
# ★ 踩过：有一次 add -A 在删它之前跑，把这个临时文件也提交进去了）
_cm.txt

# 打包输出（electron-builder 生成，发布时传 Release，不进仓库）
dist/

# 开发时放置测试文件、临时文件，不提交
tmp/

# Release 说明（由 dev\_mk_notes.mjs 从 发布说明.md 生成，发布时用，不进仓库）
# ★ 踩过（2026-10-09）：它是生成物，我却用 `git add -A` 把它提交进去了
_release_notes.md

# ---------- 系统生成的垃圾 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ★ 2026-10-09 补：_cm.txt 早就忽略了，但改用 _commit_msg.txt 时忘了加 —— 又提交进去一次。
#   教训：任何「用完即删的临时文件」，要一次把所有命名变体都写进 .gitignore。
_commit_msg.txt
_*.tmp

# ★★ 2026-10-09：提交信息临时文件 —— 这个坑踩了**三次**
#   _cm.txt → 忽略了；改用 _commit_msg.txt → 又提交；改用 _cmsg.txt → 又提交。
#   教训：别一个个加名字，**用通配符一次覆盖所有变体**（下面这行）。
_*msg*.txt
_*.tmp

# ---------- 2026-10-12：本机上试装 Electron 二进制留下的临时产物 ----------
# 背景：官方 postinstall 与 unzip/ditto 在本机沙箱里都写不进 node_modules/electron/dist
#（写临时文件再改名这一步被拦），所以手动下载解压过一份，产物留在这里。
# 这些目录**随时可删**（node_modules 本来就不进仓库）。
.electron-dl/
.electron-dist/

# ---------- 2026-10-12：开发记录（本机 agent 的工作笔记）----------
# 里面有本机绝对路径与开发过程记录，不该跟着代码提交。不需要可删掉这行。
.workbuddy/
